# Ignore everything in Synthetic_Data except the raw data and scripts we want to keep
Synthetic_Data/*_raw.csv
Synthetic_Data/*_raw.py
!Synthetic_Data/ad_catalog_raw.csv
!Synthetic_Data/ad_catalog_raw.py
!Synthetic_Data/raw_synthetic_ad_click_data.py
!Synthetic_Data/data_quality.py
!Synthetic_Data/data_quality_report.json

# Ignore pycache in subdirectories
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Ignore notebook outputs
ad_click_project/**/*.ipynb
!ad_click_project/**/*.ipynb

# Ignore large data files that should be in S3
Ad-Tech\ Optimizer/**/*_data.*
Ad-Tech\ Optimizer/**/*.parquet
Ad-Tech\ Optimizer/**/*.csv
